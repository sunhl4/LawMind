{
  "schemaVersion": 1,
  "description": "Sample LawMind policy file for firm IT review (draft). Only keys the commercial policy contract accepts are listed; unknown or engine-tuning keys are rejected with a reason (see policy.rejected in /api/health).",
  "edition": "firm",
  "allowWebSearch": false,
  "network": {
    "mode": "allowlist",
    "hosts": ["api.deepseek.com", "flk.npc.gov.cn"]
  },
  "outbound": {
    "recipientDomains": ["client.com"]
  },
  "delivery": "standard",
  "conversationLength": "200k",
  "replica": {
    "sharedDir": "/Volumes/firm-share/lawmind-relay"
  },
  "wordAddinAutoRun": false
}
