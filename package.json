{
  "name": "lawmind",
  "version": "0.2.0",
  "private": true,
  "description": "LawMind — local-first lawyer workbench (desktop shell + legal engine)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lawmind:acceptance": "node --import tsx scripts/lawmind/lawmind-acceptance.ts",
    "lawmind:agent": "node --import tsx scripts/lawmind/lawmind-agent.ts",
    "lawmind:benchmark": "node --import tsx scripts/lawmind/lawmind-benchmark.ts",
    "lawmind:bootstrap:renderer-css-markers": "node scripts/lawmind/lawmind-bootstrap-renderer-css-markers.mjs",
    "lawmind:bundle:desktop-server": "node scripts/lawmind/lawmind-bundle-desktop-server.mjs",
    "lawmind:case": "node --import tsx scripts/lawmind/lawmind-case.ts",
    "lawmind:check:renderer-css": "node scripts/lawmind/check-renderer-css.mjs",
    "lawmind:demo": "node --import tsx scripts/lawmind/lawmind-demo.ts",
    "lawmind:desktop": "pnpm --filter lawmind-desktop dev",
    "lawmind:desktop:dist": "pnpm --filter lawmind-desktop run dist:electron",
    "lawmind:desktop:e2e": "pnpm --filter lawmind-desktop test:e2e",
    "lawmind:desktop:e2e:cockpit": "pnpm --filter lawmind-desktop test:e2e -- matter-cockpit",
    "lawmind:desktop:e2e:electron": "pnpm lawmind:bundle:desktop-server && pnpm --filter lawmind-desktop build:renderer && pnpm --filter lawmind-desktop test:e2e:electron",
    "lawmind:desktop:e2e:pr": "pnpm --filter lawmind-desktop exec playwright test e2e/smoke.spec.ts e2e/golden-path.spec.ts e2e/matter-cockpit.spec.ts e2e/contract-review-trust.spec.ts e2e/settings.spec.ts e2e/workspace-chat.spec.ts e2e/dialogs.spec.ts e2e/workspace-layout.spec.ts e2e/agent-fleet.spec.ts e2e/approval-queue.spec.ts --workers=1",
    "lawmind:desktop:http-smoke": "node scripts/lawmind/lawmind-desktop-http-smoke-auto.mjs",
    "lawmind:desktop:http-smoke:probe": "node scripts/lawmind/lawmind-desktop-http-smoke.mjs",
    "lawmind:docs:build": "pnpm --filter lawmind-docs build",
    "lawmind:docs:dev": "pnpm --filter lawmind-docs dev",
    "lawmind:docs:preview": "pnpm --filter lawmind-docs preview",
    "lawmind:doctor": "node --import tsx scripts/lawmind/lawmind-doctor.ts",
    "lawmind:env:check": "node --import tsx scripts/lawmind/lawmind-env-check.ts",
    "lawmind:extract:legacy-renderer-css": "node scripts/lawmind/lawmind-extract-legacy-renderer-css.mjs",
    "lawmind:gate": "node --import tsx scripts/lawmind/lawmind-deliverable-check.ts",
    "lawmind:mcp:readonly": "node --import tsx scripts/lawmind/mcp-readonly-server.ts",
    "lawmind:multitask:audit": "node --import tsx scripts/lawmind/lawmind-multitask-audit.ts",
    "lawmind:multitask:decision": "node --import tsx scripts/lawmind/lawmind-multitask-decision.ts",
    "lawmind:multitask:guardrail": "node --import tsx scripts/lawmind/lawmind-multitask-guardrail-check.ts",
    "lawmind:multitask:observability": "node --import tsx scripts/lawmind/lawmind-multitask-observability.ts",
    "lawmind:multitask:validate": "node --import tsx scripts/lawmind/lawmind-multitask-validate.ts",
    "lawmind:multitask:validate:strict": "node --import tsx scripts/lawmind/lawmind-multitask-validate.ts --with-playwright --strict",
    "lawmind:onboard": "node --import tsx scripts/lawmind/lawmind-onboard.ts",
    "lawmind:ops": "node --import tsx scripts/lawmind/lawmind-ops.ts",
    "lawmind:quarterly-demo": "node --import tsx scripts/lawmind/lawmind-quarterly-demo.ts",
    "lawmind:release-readiness": "node --import tsx scripts/lawmind/lawmind-release-readiness.ts",
    "lawmind:review": "node --import tsx scripts/lawmind/lawmind-review.ts",
    "lawmind:sbom": "node scripts/lawmind/lawmind-sbom.mjs",
    "lawmind:sbom:cyclonedx": "sh -c 'cd apps/lawmind-desktop && pnpm dlx @cyclonedx/cyclonedx-npm@4.2.1 --ignore-npm-errors -o ../../dist/lawmind-sbom-cyclonedx-lawmind-desktop.json --spec-version 1.6'",
    "lawmind:seed:workflows": "node --import tsx scripts/lawmind/seed-workflows-cli.ts",
    "lawmind:setup": "node --import tsx scripts/lawmind/lawmind-quick-setup.ts",
    "lawmind:smoke": "node --import tsx scripts/lawmind/lawmind-smoke.ts",
    "lawmind:sync:renderer-css": "node scripts/lawmind/lawmind-sync-renderer-css.mjs",
    "lawmind:vendor:desktop-node": "node scripts/vendor-lawmind-desktop-node.mjs",
    "lawmind:verify": "pnpm test && pnpm typecheck && pnpm lawmind:benchmark -- --out dist/lawmind-benchmark.json && pnpm lawmind:release-readiness -- --out dist/lawmind-release-readiness.md && pnpm lawmind:bundle:desktop-server && pnpm --filter lawmind-desktop typecheck && pnpm lawmind:desktop:http-smoke",
    "postinstall": "node scripts/lawmind/lawmind-electron-rebuild.mjs --if-desktop",
    "prepare": "command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath git-hooks || exit 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ratchet": "node scripts/pre-commit/check-coverage-ratchet.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "imapflow": "^1.4.7",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^3.12.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.27.3",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.22.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
