# Dependencies & toolchain
node_modules/
**/node_modules/
.pnpm-store/
.tsbuildinfo

# Build outputs
dist/
**/dist/
dist-runtime/
apps/lawmind-desktop/src/renderer/canvas/sandbox-runtime.js
coverage/

# Gate/CLI 生成的报告（CI 重新生成并作为 artifact 上传；真相源是 fixtures 与源码）
# 之前误入库的 skills-golden-compare-report.json 长期陈旧且无人读取，故整体忽略。
docs/generated/

# Environment (never commit secrets)
.env
.env.*
!.env.example
!.env.lawmind.example
!.env.lawmind.team.example
!.env.lawmind.team.secrets.example
.env.lawmind.team.secrets
**/.signing-secret

# LawMind workspace — lawyer matter data (runtime truth source, never commit)
/matters/
/workspace/matters/

# LawMind workspace — 派生副本与机器本地运行时状态（真相源在代码里，不入库）
#   skills     ← src/lawmind/skills/builtin/*.md（应用启动时签名播种）
#   workflows  ← src/lawmind/agent/collaboration/*-templates.ts（ensure-workflow-seeds 播种/升级）
#   lint       ← 逃逸候选/语料/立场（metrics/lint-escape-candidates.ts 写入，审核时产生）
#   decision   ← 决策语料导出（metrics/decision-samples.ts 写入，P0 体检报告）
#   rounds     ← 影子演练工作区（scripts/lawmind/lawmind-round.ts 每跑一轮新建 <日期>-<slug>/）
# 注：仓库里仍有更早提交的副本（13 个 workflow、cn-contract-checklist）不受忽略影响；
#     是否 `git rm --cached` 由维护者决定，忽略规则先行，避免 `git add -A` 再次卷入。
workspace/lawmind/skills/
workspace/lawmind/workflows/
workspace/lawmind/automation-inbox/
workspace/lawmind/word-addin/
workspace/lawmind/works/
workspace/lawmind/metrics/
workspace/lawmind/daily-plans/
workspace/lawmind/lint/
workspace/lawmind/decision/
# 改稿范例库（learning/edit-examples.ts 写入；律师改稿时产生，可重复生成）
workspace/edits/
# 影子演练工作区（scripts/lawmind/lawmind-round.ts 写入；可重复生成，不入库）
workspace/rounds/
workspace/lawmind/daemon.json
workspace/lawmind/search-index.sqlite

