# Dependencies & toolchain
node_modules/
**/node_modules/
.pnpm-store/
.tsbuildinfo

# Build outputs
dist/
**/dist/
dist-runtime/
coverage/

# Environment (never commit secrets)
.env
.env.*
!.env.example
!.env.lawmind.example
!.env.lawmind.team.example
!.env.lawmind.team.secrets.example
.env.lawmind.team.secrets
**/.signing-secret

# LawMind workspace — lawyer matter data (runtime truth source, never commit)
/matters/

# OS / editor
.DS_Store
**/.DS_Store
.idea/
.local/
tmp/
.worktrees/

# VitePress — 同步副本（正文以仓库根目录 docs/ 为准）
apps/lawmind-docs/docs/LAWMIND-*.md
apps/lawmind-docs/docs/lawmind/
apps/lawmind-docs/docs/archive/
apps/lawmind-docs/docs/assets/
apps/lawmind-docs/docs/public/download/
# 由 sync-docs 从 docs/CNAME 与构建生成；真相源是 docs/CNAME
apps/lawmind-docs/docs/public/CNAME
apps/lawmind-docs/docs/public/.nojekyll

# LawMind desktop — 打包与本地服务器 bundle
apps/lawmind-desktop/release/
apps/lawmind-desktop/server/dist/
apps/lawmind-desktop/resources/node-runtime/*/
apps/lawmind-desktop/resources/officecli/*/

# E2E / Playwright
apps/lawmind-desktop/test-results/
apps/lawmind-desktop/playwright-report/

# Optional: other package managers（主锁文件为 pnpm-lock.yaml，应提交）
package-lock.json
bun.lock
bun.lockb

# Tooling & agent local state
.cursor/
.claude/
.agents/
.agent/
!.agent/workflows/
skills-lock.json
.serena/
.ant-colony/
/memory/

# True-manuscript binaries (PII) — keep README only; never commit client docs
fixtures/lawmind-true-manuscript/*
!fixtures/lawmind-true-manuscript/README.md

# Legacy single-file ignores（若需纳入版本控制，从下列行删除后 git add）
IDENTITY.md
USER.md

# True-manuscript trend report — runtime artifact written by the gate CLI
workspace/lawmind/metrics/true-manuscript-report.json
