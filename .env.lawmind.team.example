# LawMind team environment — DeepSeek + 北大法宝 (PKULAW)
#
# Partner quick start (after git clone):
#   1) Receive `.env.lawmind.team.secrets` from your team lead (WeChat / 1Password / private channel).
#   2) Place it next to this file in the repo root.
#   3) Run:  pnpm lawmind:setup:team
#   4) Verify: pnpm lawmind:env:check
#
# Non-secret endpoints and model names are pre-filled below.
# API keys live ONLY in `.env.lawmind.team.secrets` (never commit real keys to a public repo).

LAWMIND_INTERACTIVE_REVIEW=0
LAWMIND_AGENT_TIMEOUT_MS=180000
LAWMIND_TOOL_TIMEOUT_MS=180000

# --- DeepSeek (default agent + general model) ---
LAWMIND_AGENT_BASE_URL=https://api.deepseek.com/v1
LAWMIND_AGENT_MODEL=deepseek-v4-pro
LAWMIND_DEEPSEEK_MODEL=deepseek-v4-pro
LAWMIND_QWEN_BASE_URL=https://api.deepseek.com/v1
LAWMIND_QWEN_MODEL=deepseek-v4-pro
LAWMIND_RETRIEVAL_MODE=dual
LAWMIND_CHATLAW_BASE_URL=https://api.deepseek.com/v1
LAWMIND_CHATLAW_MODEL=deepseek-v4-pro

# --- 北大法宝 MCP (authority corpus) ---
LAWMIND_AUTHORITY_PROVIDER=pkulaw
LAWMIND_AUTHORITY_ENDPOINT=https://apim-gateway.pkulaw.com/mcp-law-search-service
LAWMIND_PKULAW_CASE_ENDPOINT=https://apim-gateway.pkulaw.com/mcp-case-search-service
LAWMIND_PKULAW_MODE=mcp_tools_call
LAWMIND_PKULAW_MCP_LAW_TOOL=search_article
LAWMIND_PKULAW_MCP_CASE_TOOL=search_case
