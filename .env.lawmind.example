# LawMind environment template
# Copy to .env.lawmind and fill only what you need.
#
# Team preset (DeepSeek + 北大法宝): see .env.lawmind.team.example
#   cp .env.lawmind.team.secrets.example .env.lawmind.team.secrets  # fill keys
#   pnpm lawmind:setup:team
#
# Manual single-user setup:
#   cp .env.lawmind.example .env.lawmind
#   source .env.lawmind
#   npm run lawmind:smoke
#
# Optional:
#   export LAWMIND_INTERACTIVE_REVIEW=1
#   npm run lawmind:smoke

# =============================================================================
# 0) Runtime toggles
# =============================================================================

# 1 = enable CLI review gate in smoke script
LAWMIND_INTERACTIVE_REVIEW=0

# Agent: OpenAI-compatible chat/completions HTTP timeout (ms). CLI default 60000; LawMind Desktop default 120000.
# LAWMIND_AGENT_TIMEOUT_MS=120000

# Agent: single tool execution budget (ms). 0 or unset = no wall-clock kill (Stop button still works).
# LAWMIND_TOOL_TIMEOUT_MS=0

# M2 optional: model-driven task routing (needs LLM creds below or LAWMIND_AGENT_*)
# LAWMIND_ROUTER_MODE=model

# M2 optional: model-driven draft layout (needs LLM creds)
# LAWMIND_REASONING_MODE=model

# Optional overrides (default: same as agent / Qwen envs)
# LAWMIND_ROUTER_BASE_URL=
# LAWMIND_ROUTER_API_KEY=
# LAWMIND_ROUTER_MODEL=
# LAWMIND_REASONING_BASE_URL=
# LAWMIND_REASONING_API_KEY=
# LAWMIND_REASONING_MODEL=


# =============================================================================
# 1) Domestic general-model providers (OpenAI-compatible)
# Fill ONE OR MORE providers as needed.
# =============================================================================

# --- Qwen / DashScope ---
# Docs endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
LAWMIND_QWEN_API_KEY=
LAWMIND_QWEN_MODEL=

# --- DeepSeek ---
# Endpoint: https://api.deepseek.com/v1
# Desktop 模型选择器里选 DeepSeek 时读取 LAWMIND_DEEPSEEK_* 或 LAWMIND_AGENT_*（见 models 解析）。
LAWMIND_DEEPSEEK_API_KEY=
LAWMIND_DEEPSEEK_MODEL=deepseek-chat

# Optional: use DeepSeek as the default agent chat model (OpenAI-compatible)
# LAWMIND_AGENT_BASE_URL=https://api.deepseek.com/v1
# LAWMIND_AGENT_API_KEY=
# LAWMIND_AGENT_MODEL=deepseek-chat

# --- GLM / Zhipu ---
# Endpoint: https://open.bigmodel.cn/api/paas/v4
LAWMIND_GLM_API_KEY=
LAWMIND_GLM_MODEL=

# --- Moonshot / Kimi ---
# Endpoint: https://api.moonshot.cn/v1
LAWMIND_MOONSHOT_API_KEY=
LAWMIND_MOONSHOT_MODEL=

# --- SiliconFlow ---
# Endpoint: https://api.siliconflow.cn/v1
LAWMIND_SILICONFLOW_API_KEY=
LAWMIND_SILICONFLOW_MODEL=


# =============================================================================
# 2) Open-source legal models (self-hosted, OpenAI-compatible)
# =============================================================================

# --- ChatLaw (primary recommended for legal specialization) ---
LAWMIND_CHATLAW_BASE_URL=
LAWMIND_CHATLAW_API_KEY=local
LAWMIND_CHATLAW_MODEL=

# --- LaWGPT (backup option) ---
LAWMIND_LAWGPT_BASE_URL=
LAWMIND_LAWGPT_API_KEY=local
LAWMIND_LAWGPT_MODEL=


# =============================================================================
# 3) LexEdge integration (framework endpoint)
# =============================================================================

# Endpoint should return ModelRetrievalOutput-compatible JSON
LAWMIND_LEXEDGE_ENDPOINT=
LAWMIND_LEXEDGE_TOKEN=


# =============================================================================
# 4) Partner local legal model (future collaboration slot)
# =============================================================================

LAWMIND_PARTNER_LEGAL_BASE_URL=
LAWMIND_PARTNER_LEGAL_API_KEY=local
LAWMIND_PARTNER_LEGAL_MODEL=


# =============================================================================
# 5) Authority corpus — 北大法宝 / 通用权威库 (BYOK, live retrieval)
# Copy filled values to desktop userData `.env.lawmind` (see 设置 → 模型与连接).
# Never commit real LAWMIND_AUTHORITY_API_KEY to git.
# =============================================================================

# Provider: open (demo corpus) | generic (GET ?q=) | pkulaw | lexis
# LAWMIND_AUTHORITY_PROVIDER=pkulaw

# Primary gateway (法宝 MCP 法规检索网关 URL，由北大法宝开放平台提供)
# LAWMIND_AUTHORITY_ENDPOINT=https://your-apim-gateway.example/mcp-law

# Optional: separate case-law MCP gateway (defaults to LAWMIND_AUTHORITY_ENDPOINT)
# LAWMIND_PKULAW_CASE_ENDPOINT=https://your-apim-gateway.example/mcp-case

# API key / Bearer token from 法宝开放平台
# LAWMIND_AUTHORITY_API_KEY=

# pkulaw mode: rest_compat | search_post | mcp_tools_call (official MCP → mcp_tools_call)
# LAWMIND_PKULAW_MODE=mcp_tools_call

# MCP tool names (official defaults: search_article / search_case)
# LAWMIND_PKULAW_MCP_LAW_TOOL=search_article
# LAWMIND_PKULAW_MCP_CASE_TOOL=search_case

# Optional citation validate against authority vendor (pkulaw MCP has no /validate by default)
# LAWMIND_AUTHORITY_CITATION_VALIDATE=0
# LAWMIND_AUTHORITY_CITATION_VALIDATE_PATH=

# DNS pin for commercial authority endpoints (recommended for pkulaw APIM)
# LAWMIND_AUTHORITY_PINNED_IP=
