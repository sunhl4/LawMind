  "acceptancePackRequired": true,
  "requiredSources": ["目标公司材料包"],
  "steps": [
    {
      "stepId": "inventory",
      "assignee": "case_analyst",
      "task": "整理尽调材料清单与缺口（matterId={{matterId}}）",
      "dependsOn": [],
      "autoApprove": true
    },
    {
      "stepId": "review",
      "assignee": "contract_reviewer",
      "task": "按尽调审查表输出分文档风险摘要（matterId={{matterId}}）",
      "dependsOn": ["inventory"],
      "autoApprove": false
    }
  ]
