# LawMind — example environment variables (development)
#
# Quick start:
# 1) Copy to `./.env` at repo root for `pnpm`/scripts, or use the desktop app's
#    userData `.env.lawmind` (see user manual).
# 2) Fill only what you use. Never commit real secrets.
#
# Precedence (typical): process env → `.env` in cwd → LawMind-managed paths.
#
# -----------------------------------------------------------------------------
# Model (OpenAI-compatible; required for chat/retrieval)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# Optional base URL override (e.g. proxy or Azure-style endpoint).
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Optional: desktop / monorepo dev
# -----------------------------------------------------------------------------
# LAWMIND_REPO_ROOT=/absolute/path/to/this/repo
# LAWMIND_RETRIEVAL_MODE=single

# -----------------------------------------------------------------------------
# Optional: Brave web search from agent tools
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# LAWMIND_WEB_SEARCH_API_KEY=...  # alias accepted by resolver

# -----------------------------------------------------------------------------
# Optional: 北大法宝 / authority live corpus (see .env.lawmind.example §5)
# -----------------------------------------------------------------------------
# LAWMIND_AUTHORITY_PROVIDER=pkulaw
# LAWMIND_AUTHORITY_ENDPOINT=https://your-apim-gateway.example/mcp-law
# LAWMIND_PKULAW_CASE_ENDPOINT=https://your-apim-gateway.example/mcp-case
# LAWMIND_AUTHORITY_API_KEY=
# LAWMIND_PKULAW_MODE=mcp_tools_call

# -----------------------------------------------------------------------------
# Optional: DeepSeek as chat model (OpenAI-compatible)
# -----------------------------------------------------------------------------
# LAWMIND_DEEPSEEK_API_KEY=
# LAWMIND_DEEPSEEK_MODEL=deepseek-chat
# LAWMIND_AGENT_BASE_URL=https://api.deepseek.com/v1
# LAWMIND_AGENT_API_KEY=
# LAWMIND_AGENT_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Optional: open-law live sources (all off by default; no commercial key)
# -----------------------------------------------------------------------------
# LAWMIND_AUTHORITY_PROVIDER=open
# LAWMIND_OPEN_LAW_MODE=hybrid
# LAWMIND_OPEN_LAW_NPC=1
# LAWMIND_OPEN_LAW_CASEOPEN=1
# LAWMIND_OPEN_LAW_COURTLISTENER=1
# LAWMIND_OPEN_LAW_COURTLISTENER_TOKEN=
# LAWMIND_OPEN_LAW_EURLEX=1
# LAWMIND_OPEN_LAW_EGOV_JP=1
# LAWMIND_OPEN_LAW_CORPUS=/abs/path/laws.jsonl
