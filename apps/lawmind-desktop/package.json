{
  "name": "lawmind-desktop",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "LawMind desktop app (Electron) — chat, tasks, and delivery history",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node ../../scripts/lawmind/apply-desktop-brand.mjs && node scripts/build-canvas-sandbox.mjs && node ../../scripts/lawmind/ensure-desktop-dev-port.mjs && concurrently -k -s first \"vite dev --port 5174\" \"wait-on http-get://127.0.0.1:5174 && electron electron/main.mjs\"",
    "build:renderer": "node scripts/build-canvas-sandbox.mjs && vite build",
    "bundle:server": "pnpm -w lawmind:bundle:desktop-server",
    "vendor:node": "pnpm -w lawmind:vendor:desktop-node",
    "vendor:officecli": "pnpm -w lawmind:vendor:officecli",
    "defaults:write": "node scripts/write-bundled-defaults.mjs",
    "defaults:check": "node scripts/write-bundled-defaults.mjs --print",
    "typecheck": "tsc --noEmit",
    "dist:electron": "node scripts/write-bundled-defaults.mjs --print && pnpm bundle:server && pnpm vendor:node && pnpm vendor:officecli && pnpm build:renderer && node scripts/assert-vendored-runtimes.mjs && electron-builder --publish never",
    "dist:electron:arm64": "node scripts/write-bundled-defaults.mjs --print && pnpm bundle:server && pnpm vendor:node --arch arm64 && pnpm vendor:officecli --arch arm64 && pnpm build:renderer && node scripts/assert-vendored-runtimes.mjs --arch arm64 && electron-builder --arm64 --publish never",
    "dist:electron:x64": "node scripts/write-bundled-defaults.mjs --print && pnpm bundle:server && pnpm vendor:node --arch x64 && pnpm vendor:officecli --arch x64 && pnpm build:renderer && node scripts/assert-vendored-runtimes.mjs --arch x64 && electron-builder --x64 --publish never",
    "dist:electron:mac:both": "node scripts/write-bundled-defaults.mjs --print && pnpm bundle:server && pnpm vendor:node --arch arm64 && pnpm vendor:node --arch x64 && pnpm vendor:officecli --arch arm64 && pnpm vendor:officecli --arch x64 && pnpm build:renderer && node scripts/assert-vendored-runtimes.mjs --arch arm64,x64 && electron-builder --arm64 --x64 --publish never",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.7",
    "pdfjs-dist": "5.4.296",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "ai.lawmind.desktop",
    "productName": "LawMind",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.test.ts",
      "branding/manifest.json",
      "dist/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/node-runtime/${platform}-${arch}",
        "to": "node-runtime/${platform}-${arch}",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server/dist",
        "to": "lawmind-server",
        "filter": [
          "**/*.cjs"
        ]
      },
      {
        "from": "../../src/lawmind/skills/builtin",
        "to": "lawmind-server/builtin",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "resources/officecli/${platform}-${arch}",
        "to": "officecli/${platform}-${arch}",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/word-addin",
        "to": "word-addin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/defaults",
        "to": "defaults",
        "filter": [
          "**/*.json"
        ]
      }
    ],
    "afterPack": "electron/after-pack-mac.mjs",
    "afterAllArtifactBuild": "electron/after-all-artifact-build-mac.mjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.inherit.plist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "maintainer": "LawMind"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sunhl4",
        "repo": "LawMind"
      }
    ]
  }
}
