# Electron main-process debug logging (writes .cursor/debug-lawmind.log under repo root). Local dev only.
# LAWMIND_DEBUG_SESSION=1

# Copy to `.env.e2e` for Playwright (`vite --mode e2e` loads env from apps/lawmind-desktop/).
# Mock API port must match LAWMIND_E2E_MOCK_PORT in e2e/dev-with-mock.sh (default 48888).
VITE_LAWMIND_DEV_API=http://127.0.0.1:48888

# Local loopback only: allow Doctor / POST /api/search/workspace/rebuild (full FTS rebuild).
# Do not set in production workspaces; see docs/LAWMIND-WORKSPACE-STANDARD.md
# LAWMIND_ALLOW_INDEX_REBUILD=1
